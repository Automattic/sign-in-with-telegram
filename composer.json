{
    "name": "automattic/telegram-auth",
    "description": "Let your visitors sign in to WordPress with their Telegram account.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Automattic/telegram-auth",
    "require": {
        "php": ">=8.1",
        "automattic/jetpack-autoloader": "^5.0",
        "automattic/jetpack-wp-build-polyfills": "^0.1",
        "firebase/php-jwt": "^6.10 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/php/"
        ]
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpunit": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
