	"description": "A button visitors can click to sign in with their Telegram account.",
	"keywords": [ "telegram", "login", "auth", "sign in" ],
	"textdomain": "sign-in-with-telegram",
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ],
		"spacing": { "margin": true, "padding": true }
	},
	"attributes": {
		"label": { "type": "string", "default": "" },
		"redirectTo": { "type": "string", "default": "" }
	}
}
