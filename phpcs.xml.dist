<?xml version="1.0"?>
<ruleset name="sign-in-with-telegram">
	<description>Coding standards for the Sign in with Telegram plugin.</description>

	<file>src</file>
	<file>sign-in-with-telegram.php</file>
	<file>uninstall.php</file>

	<!--
		Tests are deliberately excluded from PHPCS scope. Test files use
		PHPUnit's filename-must-match-class-stem convention (Foo_Test.php
		for class Foo_Test), which conflicts with WPCS's class-foo-test.php
		naming rule. Tests are dev infrastructure only — they don't ship to
		users — so we don't enforce production code style on them.
	-->
	<exclude-pattern>tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="sign-in-with-telegram"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="telegram_signin,Automattic\Telegram\SignIn,TELEGRAM_SIGNIN"/>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>packages/*/build/*</exclude-pattern>
	<exclude-pattern>packages/*/build-module/*</exclude-pattern>
	<exclude-pattern>temp/*</exclude-pattern>
</ruleset>
