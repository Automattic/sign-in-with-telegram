<?xml version="1.0"?>
<ruleset name="telegram-auth">
	<description>Coding standards for the Telegram Auth plugin.</description>

	<file>src</file>
	<file>tests/php</file>
	<file>telegram-auth.php</file>
	<file>uninstall.php</file>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<rule ref="WordPress">
		<!--
			We use PSR-4 PascalCase.php filenames so Composer's autoloader
			works without a custom loader. The rest of WPCS still applies.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="telegram-auth"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="telegram_auth,Telegram_Auth,TELEGRAM_AUTH"/>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>packages/*/build/*</exclude-pattern>
	<exclude-pattern>packages/*/build-module/*</exclude-pattern>
	<exclude-pattern>temp/*</exclude-pattern>
</ruleset>
