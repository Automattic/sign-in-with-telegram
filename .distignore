# Files and directories excluded from the production plugin artifact
# distributed to wp.org. Honoured by WordPress/plugin-check-action and
# 10up/action-wordpress-plugin-deploy.
# Dev infrastructure. Patterns _without_ a leading slash match anywhere in
# the tree — needed because Composer occasionally installs packages from
# source (e.g. firebase/php-jwt ships a `.git/`, `.gitignore`, `.github/`,
# and a `.php-cs-fixer.dist.php` config), and wp.org's plugin reviewer
# rejects the upload if any of those land in the zip ("hidden files are
# not permitted", "unexpected files: .git").
.git
.gitattributes
.gitkeep
.github
.gitignore
.php-cs-fixer*
.styleci.yml
.travis.yml
.vscode
/.wp-env
/.wordpress-org
/.editorconfig
/.npmrc
/.nvmrc
/.distignore
/.dist
# release-please plumbing — consumed only by CI / GitHub Actions.
/release-please-config.json
/.release-please-manifest.json
/CHANGELOG.md
/.agents
/.claude
/.cursor

# Source-only directories. The zip ships compiled artifacts only;
# the TypeScript / TSX origin of the bundled JS under build/ is
# publicly accessible via the GitHub link in readme.txt (the route
# wp.org's plugin guidelines #4 allows: "include a link in the readme
# to the development location" as an alternative to bundling sources).
#
# `tests`, `test`, `__tests__`, `__mocks__`, `docs`, `examples` are
# unanchored on purpose — vendor packages routinely ship test
# fixtures (e.g. firebase/php-jwt's tests/) that don't belong in the
# user-facing zip.
/bin
/packages
/routes
docs
examples
tests
test
__tests__
__mocks__
/temp
/node_modules
/vendor/bin

# Package manifests + lockfiles. composer.json + composer.lock ship so
# wp.org reviewers can audit dependencies (their automated check fails
# the plugin when a Composer-using zip lacks composer.json).
/package.json
/package-lock.json
/jest.config.cjs
/tsconfig.json
/eslint.config.js
/stylelint.config.cjs
/.stylelintrc.json
/patchwork.json

# wp-env / local-dev config
/.wp-env.json
/.wp-env.override.json
/wp-env.override.json

# Lint / sniffer configs (consumed only at dev time)
/phpcs.xml.dist
/phpunit.xml.dist

# Source-map and TypeScript build artifacts that wp-build leaves alongside
# the bundled outputs (the minified .min.js is what ships).
/packages/*/build-module
/packages/*/build
*.map

# Planning + agent-facing docs that aren't part of the user-facing plugin.
AGENTS.md
CLAUDE.md
CONTRIBUTING.md

# Local-machine artifacts that may appear in a developer's working tree
# but should never ship to wp.org. Unanchored — match at any depth.
.DS_Store
.phpunit.cache

# Dotenv files.
.env
.env.*
.envrc
