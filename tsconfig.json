{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"types": [ "jest" ]
	},
	"include": [ "routes/**/*", "packages/*/src/**/*" ],
	"exclude": [ "node_modules", "build", "build-module", "packages/*/build", "packages/*/build-module" ]
}
