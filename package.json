{
	"name": "telegram-auth",
	"version": "0.1.0",
	"description": "Let your visitors sign in to WordPress with their Telegram account.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"homepage": "https://github.com/Automattic/telegram-auth",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/telegram-auth.git"
	},
	"scripts": {
		"build": "wp-build",
		"dev": "wp-build --watch",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env destroy --force && wp-env start",
		"env:cli": "wp-env run cli wp",
		"env:logs": "wp-env logs",
		"lint:js": "eslint 'packages/**/*.{ts,tsx,js,jsx}'",
		"lint:js:fix": "eslint 'packages/**/*.{ts,tsx,js,jsx}' --fix",
		"typecheck": "tsc --noEmit",
		"lint:css": "stylelint \"packages/**/*.scss\" --allow-empty-input",
		"lint:css:fix": "stylelint \"packages/**/*.scss\" --allow-empty-input --fix",
		"format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,scss,json}\"",
		"test": "jest --passWithNoTests"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/jest": "*",
		"@types/wordpress__components": "*",
		"@wordpress/api-fetch": "*",
		"@wordpress/build": "0.13.0",
		"@wordpress/components": "*",
		"@wordpress/dataviews": "*",
		"@wordpress/element": "*",
		"@wordpress/env": "*",
		"@wordpress/eslint-plugin": "*",
		"@wordpress/i18n": "*",
		"@wordpress/jest-preset-default": "*",
		"@wordpress/prettier-config": "*",
		"@wordpress/stylelint-config": "*",
		"eslint": "^9.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"prettier": "^3.8.3",
		"stylelint": "^16.0.0",
		"ts-jest": "^29.0.0",
		"typescript": "^6.0.3"
	},
	"prettier": "@wordpress/prettier-config",
	"wpPlugin": {
		"name": "telegram_auth",
		"scriptGlobal": "telegramAuth",
		"packageNamespace": "telegram-auth"
	}
}
