# Build outputs — produced fresh in CI before deploy.
build/
packages/*/build/
packages/*/build-module/
**/*.map
.phpunit.cache/
.dist/

# Dependency installs.
vendor/
node_modules/

# Local dev environment.
.wp-env/
.wp-env.override.json

# Logs.
*.log

# OS / editor cruft.
.DS_Store
.idea/
*.swp
*.swo

/temp/

# Per-agent slash-command shim directories. Populated by `npm run setup:<agent>`
# from the canonical skill files at `.agents/commands/`.
/.claude/commands/
/.cursor/commands/
